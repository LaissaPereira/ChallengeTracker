{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=challenge.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "ChallengeTrackerApi",
    "Audience": "ChallengeTrackerApi",
    "ExpiresInMinutes": 60
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Login": { "PermitLimit": 5, "WindowSeconds": 60 },
    "Register": { "PermitLimit": 5, "WindowSeconds": 60 },
    "PerUser": { "PermitLimit": 60, "WindowSeconds": 60 }
  }
}
